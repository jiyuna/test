<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>별이의 미니 RPG</title>
</head>
<body>
    <h1>별이의 미니 RPG</h1>

    <p id="hp">HP : 100</p>
    <p id="gold">Gold : 50</p>

    <button onclick="heal()">회복하기</button>
    <button onclick="work()">알바하기</button>
    <button onclick="buyPotion()">물약 사기</button>

    <p id="message">무엇을 할까?</p>

    <script>
        let hp = 100;
        let gold = 50;

        function showStatus() {
            document.getElementById("hp").innerText = "HP : " + hp;
            document.getElementById("gold").innerText = "Gold : " + gold;
        }

        function heal() {
            hp += 10;
            document.getElementById("message").innerText = "체력을 10 회복했다!";
            showStatus();
        }

        function work() {
            gold += 20;
            hp -= 5;
            document.getElementById("message").innerText = "알바해서 20골드를 벌었다. HP는 5 줄었다.";
            showStatus();
        }

        function buyPotion() {
            if (gold >= 30) {
                gold -= 30;
                hp += 30;
                document.getElementById("message").innerText = "물약을 샀다! HP 30 회복!";
            } else {
                document.getElementById("message").innerText = "골드가 부족하다!";
            }

            showStatus();
        }
    </script>
</body>
</html>
